pipeline {
    agent any

    stages {
        stage('Build') {
            stages {
                stage('Compile') {
                    steps {
                        script {
                            def someCondition = true
                            if (someCondition) {
                                currentBuild.result = 'FAILURE'
                                error("Stopping the pipeline: Validation failed!")
                            }
                        }
                    }
                }
            }
        }
    }
}
